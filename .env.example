APP_ENV=dev
APP_PORT=3000

# sqlite (default) or postgres
DB_DRIVER=sqlite
SQLITE_PATH=./data/app.db
# DATABASE_URL=postgres://user:pass@localhost:5432/boilerplate?sslmode=disable

SESSION_SECRET=change-me-min-32-chars
SESSION_TTL_HOURS=12

# Seed admin (used only when users table is empty)
ADMIN_USER=admin
ADMIN_PASS=admin123
